datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

model History_Rates {
  base_code        String
  year             Int
  month            Int
  day              Int
  conversion_rates Json

  @@id([base_code, year, month, day])
}

model Codes {
  id    Int    @id @default(autoincrement())
  codes Json
  hash  String @unique
}

model Current_Rates {
  base_code        String @id
  next_update      BigInt
  conversion_rates Json
}
