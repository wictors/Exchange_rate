datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

model Standard {
  base_code        String   @id
  last_update      DateTime
  next_update      DateTime
  conversion_rates Json
}