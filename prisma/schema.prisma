datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

model History_Rates {
  base_code        String   @id
  year             Int
  month            Int
  day              Int
  conversion_rates Json
}

model Codes {
  id    Int      @id @default(autoincrement())
  codes Json
}
