datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

model Rates {
  base_code        String
  date             DateTime
  conversion_rates Json

  @@id([base_code, date])
}

model Codes {
  id    Int    @id @default(autoincrement())
  codes Json
  hash  String @unique
}
